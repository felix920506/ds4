# Copy to .env and adjust.  Every value here has a default in compose.yaml.

# Image tag.  dev-rocm follows main; dev-rocm-<sha> pins one commit.
#DS4_IMAGE=ghcr.io/felix920506/ds4:dev-rocm

# Host directory holding the GGUF files (mounted read-only at /models).
DS4_MODELS=../../gguf

# Model and vision encoder file names inside DS4_MODELS.
#DS4_MODEL=DeepSeek-V4-Flash-Vision-Exp-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8.gguf
#DS4_VISION=DeepSeek-V4-Flash-Vision-Encoder.gguf

# Address and port the API is published on.  Use 0.0.0.0 to reach it from
# other machines; the API has no authentication.
#DS4_BIND=127.0.0.1
#DS4_PORT=8000

# Context reservation in tokens and disk KV budget in MiB.
#DS4_CTX=1000000
#DS4_KV_DISK_MB=32768
