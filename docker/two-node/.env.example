# Copy to .env on both machines and adjust.  Keep every value except
# COMPOSE_PROFILES identical on the two machines.

# Which stage this machine runs: coordinator or worker.
COMPOSE_PROFILES=coordinator

# The coordinator's address on the link between the two machines.  The
# worker connects to it on DS4_DIST_PORT.
COORDINATOR_IP=192.168.1.10
#DS4_DIST_PORT=9911

# Image tag.  dev-rocm follows main; pin dev-rocm-<sha> to keep the two
# machines on the same build.
#DS4_IMAGE=ghcr.io/felix920506/ds4:dev-rocm

# Host directory holding the GGUF files (mounted read-only at /models).
DS4_MODELS=../../gguf

# Model and vision encoder file names inside DS4_MODELS.
#DS4_MODEL=DeepSeek-V4-Flash-Vision-Exp-MXFP4Experts-F16HC-F16Compressor-F16Indexer-Q8Attn-Q8Shared-Q8Out.gguf
#DS4_VISION=DeepSeek-V4-Flash-Vision-Encoder.gguf

# Layer split: coordinator 0..20, worker 21..output.
#DS4_SPLIT_LAST_COORDINATOR_LAYER=20
#DS4_SPLIT_FIRST_WORKER_LAYER=21

# HTTP API of the coordinator (host network).  Use 0.0.0.0 to reach it from
# other machines; the API has no authentication.
#DS4_BIND=127.0.0.1
#DS4_PORT=8000

# Must match on both machines.
#DS4_CTX=1000000
#DS4_PREFILL_CHUNK=2048

# Disk KV budget on the coordinator, in MiB.
#DS4_KV_DISK_MB=32768
